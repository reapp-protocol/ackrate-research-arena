{
  "name": "ackrate-research-arena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "gate": "npm run lint && npm run build && npm test && npm audit --omit=dev --audit-level=high",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/app.test.ts src/lib/orchestrator.test.ts",
    "test:app": "node --import tsx --test src/app.test.ts",
    "test:orchestrator": "node --import tsx --test src/lib/orchestrator.test.ts"
  },
  "dependencies": {
    "@ackrate/ap2": "^0.3.0",
    "@ackrate/core": "^0.3.1",
    "@anthropic-ai/sdk": "^0.115.0",
    "@stellar/stellar-sdk": "^14.6.1",
    "cors": "^2.8.5",
    "dotenv": "^17.0.0",
    "express": "^5.2.1",
    "openai": "^7.3.0",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "esbuild": "^0.25.0",
    "eslint": "^9",
    "tsx": "^4.20.0",
    "typescript": "^5"
  }
}
