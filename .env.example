# server
NODE_ENV=development
PORT=3000
APP_URL=https://ackrate-research-arena-production.up.railway.app
FRONTEND_URL=https://ackratearena.xyz
CORS_ORIGINS=https://ackratearena.xyz,https://www.ackratearena.xyz,https://research-reveal-production.up.railway.app,http://localhost:5173
DEMO_MODE=true

# Supabase Postgres (server only). Use the Session pooler URI from Connect.
DATABASE_PROVIDER=supabase
DATABASE_URL=postgresql://postgres.PROJECT_REF:PERCENT_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# research providers (server only)
OPENAI_API_KEY=
OPEN_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_JUDGE_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# Optional: make Claude the first judge; the other provider remains the fallback.
AI_JUDGE_PROVIDER=openai

# prava sandbox
PRAVA_API_BASE_URL=https://sandbox.api.prava.space
PRAVA_SECRET_KEY=
PRAVA_PUBLISHABLE_KEY=
PRAVA_MERCHANT_URL=https://ackratearena.xyz
PRAVA_MERCHANT_COUNTRY=US
PRAVA_MERCHANT_CATEGORY_CODE=7392
PRAVA_CALLBACK_URL=
